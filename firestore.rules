rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 共用文件：只要是登入使用者（任何 Google 帳號）都能讀寫這一份資料。
    // 這是刻意選擇的「完全開放給登入者共編」模式——不是每人各自一份，
    // 所有登入者看到、編輯的都是同一份 shared/fashionReport 文件。
    // 代表任何用 Google 帳號登入的人都能修改或刪除這份共用資料，
    // 沒有白名單限制，這點是使用者自己選擇的設計。
    match /shared/fashionReport {
      allow read, write: if request.auth != null;
    }

    // 其他任何路徑一律拒絕（白名單原則）。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
